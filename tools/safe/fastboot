#!/usr/bin/env python3
import sys
import os
import subprocess
from datetime import datetime

LOG_FILE = "/run/media/apex/New Volume/oos16-port/logs/phone-commands.log"
REAL_FASTBOOT = "/usr/bin/fastboot"

def log_command(allowed, args):
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    with open(LOG_FILE, "a") as f:
        timestamp = datetime.now().isoformat()
        status = "ALLOWED" if allowed else "BLOCKED"
        f.write(f"[{timestamp}] [FASTBOOT] [{status}] {' '.join(args)}\n")

args = sys.argv[1:]

if not args:
    res = subprocess.run([REAL_FASTBOOT])
    sys.exit(res.returncode)

cmd = args[0].lower()

# Check against absolute banned operations
BANNED_SUBCOMMANDS = [
    "flash", "flashall", "flashing", "update", "erase", "format", 
    "wipe", "set_active", "snapshot-update", "gsi", "oem"
]

for b in BANNED_SUBCOMMANDS:
    if cmd == b or f"-{b}" in args or f"--{b}" in args:
        log_command(False, args)
        print(f"[SAFETY VIOLATION] fastboot command '{' '.join(args)}' contains banned operation '{b}'. ABORTING.", file=sys.stderr)
        sys.exit(1)

if "-w" in args or "--wipe" in args:
    log_command(False, args)
    print(f"[SAFETY VIOLATION] fastboot wipe flag detected in '{' '.join(args)}'. ABORTING.", file=sys.stderr)
    sys.exit(1)

# Allowlists
is_allowed = False

if cmd in ["devices", "help", "--help", "-h", "version", "--version"]:
    is_allowed = True
elif cmd == "getvar":
    is_allowed = True
elif cmd == "reboot":
    if len(args) == 1 or (len(args) == 2 and args[1] in ["bootloader", "fastboot"]):
        is_allowed = True
elif cmd == "boot":
    if len(args) == 2:
        img_path = args[1]
        # Booting from RAM allowed only if file exists
        if os.path.isfile(img_path):
            is_allowed = True
        else:
            print(f"[SAFETY ERROR] Fastboot boot image '{img_path}' not found.", file=sys.stderr)
            sys.exit(1)

if is_allowed:
    log_command(True, args)
    res = subprocess.run([REAL_FASTBOOT] + args)
    sys.exit(res.returncode)
else:
    log_command(False, args)
    print(f"[SAFETY VIOLATION] fastboot command '{' '.join(args)}' is not in the strict allowlist. Refused.", file=sys.stderr)
    sys.exit(1)
