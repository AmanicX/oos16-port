#!/usr/bin/env python3
"""
tools/safe/adb - Hardened Safety Interceptor Proxy for Android Debug Bridge
Enforces strict zero-storage-write guarantees for OxygenOS 16 RAM Bringup.
All destructive commands, shell metacharacters, path traversal, executable spoofing,
state-clearing diagnostics, and non-RAM targets are strictly rejected.
"""

import sys
import os
import posixpath
import subprocess
import shlex
import re
from datetime import datetime

LOG_FILE = "/run/media/apex/New Volume/oos16-port/logs/phone-commands.log"

# 1. Validated Real ADB Binary Discovery
ALLOW_MOCK_ENV = "OOS16_TEST_MODE"
APPROVED_SYSTEM_ADB_DIRS = ("/usr/bin", "/bin", "/usr/local/bin")

if "REAL_ADB_BIN" in os.environ:
    REAL_ADB = os.environ["REAL_ADB_BIN"]
    if os.path.exists(REAL_ADB) and os.path.realpath(REAL_ADB) == os.path.realpath(__file__):
        print(f"[ADB SAFETY ERROR] REAL_ADB_BIN points to the safety wrapper itself (infinite recursion rejected).", file=sys.stderr)
        sys.exit(1)

    is_test_mode = os.environ.get(ALLOW_MOCK_ENV, "").lower() in ["1", "true", "yes"]
    if not is_test_mode:
        canon_adb = posixpath.normpath(os.path.realpath(REAL_ADB))
        if not any(canon_adb.startswith(d + "/") or canon_adb == d for d in APPROVED_SYSTEM_ADB_DIRS):
            print(f"[ADB SAFETY ERROR] Arbitrary REAL_ADB_BIN override '{REAL_ADB}' is rejected in production (set {ALLOW_MOCK_ENV}=1 for testing).", file=sys.stderr)
            sys.exit(1)

    if not os.path.exists(REAL_ADB):
        print(f"[ADB SAFETY ERROR] REAL_ADB_BIN '{REAL_ADB}' does not exist.", file=sys.stderr)
        sys.exit(1)
    if not os.access(REAL_ADB, os.X_OK):
        print(f"[ADB SAFETY ERROR] REAL_ADB_BIN '{REAL_ADB}' is not executable.", file=sys.stderr)
        sys.exit(1)
else:
    REAL_ADB = "/usr/bin/adb"
    if not os.path.exists(REAL_ADB):
        for p in os.environ.get("PATH", "").split(os.path.pathsep):
            candidate = os.path.join(p, "adb")
            if os.path.exists(candidate) and os.path.abspath(candidate) != os.path.abspath(__file__):
                REAL_ADB = candidate
                break

def log_command(allowed, args, reason=""):
    timestamp = datetime.now().isoformat()
    status = "ALLOWED" if allowed else "BLOCKED"
    extra = f" [{reason}]" if reason else ""
    log_line = f"[{timestamp}] [ADB] [{status}]{extra} {' '.join(args)}\n"
    
    logged = False
    for target in [LOG_FILE, "/tmp/phone-commands.log"]:
        try:
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, "a") as f:
                f.write(log_line)
            logged = True
            break
        except Exception:
            continue
            
    if not logged:
        print(f"[ADB SAFETY LOGGING ERROR] Failed to record audit log for command: {' '.join(args)}", file=sys.stderr)

def abort(msg, args):
    log_command(False, args, msg)
    print(f"[ADB SAFETY VIOLATION] {msg}. Refused.", file=sys.stderr)
    sys.exit(1)

raw_args = sys.argv[1:]
if not raw_args:
    res = subprocess.run([REAL_ADB])
    sys.exit(res.returncode)

# 2. Parse global adb flags (-s <serial>, -d, -e, -t <id>, -H <host>, -P <port>)
idx = 0
global_flags = []
while idx < len(raw_args):
    arg = raw_args[idx]
    if arg in ["-d", "-e"]:
        global_flags.append(arg)
        idx += 1
    elif arg in ["-s", "-t", "-H", "-P", "-L"]:
        if idx + 1 >= len(raw_args):
            abort(f"Global flag '{arg}' missing required argument", raw_args)
        global_flags.extend([arg, raw_args[idx + 1]])
        idx += 2
    elif arg.startswith("-"):
        abort(f"Disallowed global flag '{arg}'", raw_args)
    else:
        break

if idx >= len(raw_args):
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

subcmd = raw_args[idx]
subargs = raw_args[idx + 1:]

# 3. Strict Whitelist of Safe ADB Subcommands
SAFE_NOARG_CMDS = {"devices", "get-state", "version", "help", "--help", "wait-for-device", "root"}

if subcmd in SAFE_NOARG_CMDS:
    if subcmd == "devices":
        if subargs and subargs != ["-l"]:
            abort("Unexpected arguments to 'adb devices'", raw_args)
    elif subcmd in ["get-state", "version", "help", "--help", "wait-for-device", "root"]:
        if subargs:
            abort(f"Unexpected arguments to 'adb {subcmd}'", raw_args)

    log_command(True, raw_args)
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

elif subcmd == "reboot":
    if len(subargs) == 0:
        pass
    elif len(subargs) == 1 and subargs[0] in ["bootloader", "fastboot", "recovery"]:
        pass
    else:
        abort(f"Disallowed reboot target: '{' '.join(subargs)}'", raw_args)

    log_command(True, raw_args)
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

elif subcmd == "pull":
    if len(subargs) < 1:
        abort("adb pull requires at least a source path", raw_args)
    log_command(True, raw_args)
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

elif subcmd == "push":
    # Push destination MUST be canonicalized and strictly within volatile RAM (/tmp/ or /mnt/).
    if len(subargs) < 2:
        abort("adb push requires source and destination arguments", raw_args)
    
    raw_dest = subargs[-1]
    
    # Path traversal check: reject any explicit '..' or '.' in destination
    dest_parts = raw_dest.split("/")
    if ".." in dest_parts or "." in dest_parts:
        abort(f"Path traversal detected in destination '{raw_dest}'. Refused", raw_args)

    canonical_dest = posixpath.normpath(raw_dest)
    
    # Explicit rejection of physical storage targets (/sdcard, /data, /storage)
    if any(canonical_dest == r or canonical_dest.startswith(r + "/") for r in ["/sdcard", "/storage", "/data"]):
        abort(f"Push destination '{raw_dest}' targets physical storage. REJECTED", raw_args)

    # Allow strictly /tmp or /mnt hierarchy with alphanumeric, dash, dot, underscore elements
    if not re.match(r"^/(tmp|mnt)(/[a-zA-Z0-9_.-]+)*$", canonical_dest):
        abort(f"Push destination '{raw_dest}' contains illegal characters or is outside approved RAM directories (/tmp/, /mnt/). Refused", raw_args)

    # Verify all local sources exist on host
    sources = subargs[:-1]
    for src in sources:
        if not os.path.exists(src):
            abort(f"Local source file '{src}' does not exist on host", raw_args)

    # Remote Symlink Escape Check (Probe target resolution before pushing)
    try:
        probe = subprocess.run(
            [REAL_ADB] + global_flags + ["shell", "readlink", "-f", canonical_dest],
            capture_output=True, text=True, timeout=2
        )
        resolved = probe.stdout.strip()
        if resolved and not resolved.startswith(("/tmp", "/mnt")):
            abort(f"Remote destination '{canonical_dest}' is a symlink resolving to '{resolved}' outside approved RAM directories. REJECTED", raw_args)
    except Exception:
        pass

    log_command(True, raw_args)
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

elif subcmd in ["shell", "exec-out"]:
    if not subargs:
        abort("Interactive adb shell sessions are blocked to prevent untracked writes", raw_args)

    shell_str = " ".join(subargs).strip()

    # Reject any shell chaining, piping, redirection, or command substitution
    SHELL_METACHAR_PATTERN = re.compile(r"[;&|><$`\n\r()]")
    if SHELL_METACHAR_PATTERN.search(shell_str):
        abort(f"Shell metacharacters (chaining, pipes, redirection, subshell) are strictly blocked: '{shell_str}'", raw_args)

    try:
        tokens = shlex.split(shell_str)
    except Exception as e:
        abort(f"Malformed shell command string: {e}", raw_args)

    if not tokens:
        abort("Empty shell command", raw_args)

    raw_binary = tokens[0]
    cmd_args = tokens[1:]

    # Executable Path Validation (Prevents executable path spoofing)
    APPROVED_SYSTEM_BIN_DIRS = {"/system/bin", "/system/xbin", "/bin", "/vendor/bin", "/odm/bin"}

    if "/" in raw_binary:
        binary_dir = posixpath.dirname(posixpath.normpath(raw_binary))
        if binary_dir not in APPROVED_SYSTEM_BIN_DIRS:
            abort(f"Executable path spoofing attempt: binary '{raw_binary}' is outside approved system directories. Refused", raw_args)
        norm_cmd = posixpath.basename(raw_binary)
    else:
        norm_cmd = raw_binary

    # Whitelist of approved diagnostic tools and strict argument validators
    ALLOWED_DIAGNOSTIC_COMMANDS = {
        "getprop": lambda a: all(re.match(r"^[a-zA-Z0-9_.-]+$", x) for x in a) and len(a) <= 1,
        "dmesg": lambda a: all(x in ["-s", "-r", "-n", "-l"] or (not x.startswith("-") and re.match(r"^[0-9]+$", x)) for x in a),  # State-modifying -c BLOCKED
        "logcat": lambda a: all(
            (x in ["-d", "-b", "all", "main", "system", "crash", "events", "-v", "threadtime", "brief", "time", "-s"]) or
            (not x.startswith("-") and re.match(r"^[a-zA-Z0-9_:*.-]+$", x))
            for x in a
        ),  # State-modifying -c BLOCKED
        "ps": lambda a: all(x in ["-ef", "-A", "-e", "-f", "-l", "-T", "-o"] or re.match(r"^[a-zA-Z0-9_,]+$", x) for x in a),
        "df": lambda a: all(x in ["-h", "-k", "-m", "-a"] or (x.startswith("/") and ".." not in x) for x in a),
        "free": lambda a: all(x in ["-m", "-k", "-h", "-b"] for x in a),
        "uname": lambda a: all(x in ["-a", "-r", "-m", "-n", "-s", "-v"] for x in a),
        "id": lambda a: len(a) == 0 or all(x in ["-u", "-g", "-n", "-G"] for x in a),
        "whoami": lambda a: len(a) == 0,
        "uptime": lambda a: len(a) == 0,
        "mount": lambda a: len(a) == 0,  # Read-only mount table inspection ONLY
        "lshal": lambda a: all(x in ["--types=all", "--types=b", "--types=c", "-v"] for x in a),
        "dumpsys": lambda a: all(re.match(r"^[a-zA-Z0-9_.-]+$", x) for x in a) and len(a) <= 2,
        "cat": lambda a: len(a) == 1 and a[0].startswith(("/proc/", "/sys/", "/mnt/", "/tmp/")) and ".." not in a[0],
        "ls": lambda a: all(
            x in ["-l", "-a", "-d", "-1", "-F", "-la", "-lh", "-ld"] or
            (x.startswith(("/sys/block", "/dev/block", "/tmp", "/mnt", "/proc", "/sys", "/dev", "/system", "/vendor", "/apex", "/linkerconfig")) and ".." not in x)
            for x in a
        ),
        "test": lambda a: (
            len(a) == 2 and a[0] in ["-e", "-b", "-f", "-d", "-c", "-L"] and
            a[1].startswith(("/sys/block", "/dev/block", "/tmp", "/mnt")) and ".." not in a[1]
        ),
        "readlink": lambda a: len(a) <= 2 and all(x in ["-f", "-m", "-n"] or (x.startswith("/") and ".." not in x) for x in a),
        "file": lambda a: len(a) <= 2 and all(x in ["-b", "-L"] or (x.startswith(("/tmp", "/mnt", "/system", "/vendor", "/apex")) and ".." not in x) for x in a),
        "sha256sum": lambda a: all(x.startswith(("/tmp", "/mnt")) and ".." not in x for x in a),
        "md5sum": lambda a: all(x.startswith(("/tmp", "/mnt")) and ".." not in x for x in a),
        "blockdev": lambda a: len(a) == 2 and a[0] == "--getro" and a[1].startswith("/dev/block/") and ".." not in a[1],
        "touch": lambda a: len(a) == 1 and a[0] in [
            "/tmp/watchdog_cancel", "/tmp/watchdog_heartbeat",
            "/mnt/watchdog_cancel", "/mnt/watchdog_heartbeat",
            "/mnt/boot_now", "/tmp/boot_now"
        ],
        "rm": lambda a: len(a) == 2 and a[0] == "-f" and a[1] in [
            "/tmp/watchdog_cancel", "/tmp/watchdog_heartbeat",
            "/mnt/watchdog_cancel", "/mnt/watchdog_heartbeat",
            "/mnt/boot_now", "/tmp/boot_now"
        ]
    }

    # Handle toybox/toolbox wrapper: toybox <applet> <args>
    if norm_cmd in ["toybox", "toolbox"]:
        if not cmd_args:
            abort(f"Missing applet for '{norm_cmd}'", raw_args)
        raw_applet = cmd_args[0]
        if "/" in raw_applet:
            abort(f"Applet path spoofing attempt: '{raw_applet}'. Refused", raw_args)
        applet = raw_applet
        applet_args = cmd_args[1:]
        if applet not in ALLOWED_DIAGNOSTIC_COMMANDS:
            abort(f"Toybox applet '{applet}' is not in the safe whitelist", raw_args)
        validator = ALLOWED_DIAGNOSTIC_COMMANDS[applet]
        if not validator(applet_args):
            abort(f"Arguments to toybox applet '{applet}' rejected: {applet_args}", raw_args)
    else:
        if norm_cmd not in ALLOWED_DIAGNOSTIC_COMMANDS:
            abort(f"Command '{norm_cmd}' is not in the safe whitelist", raw_args)
        validator = ALLOWED_DIAGNOSTIC_COMMANDS[norm_cmd]
        if not validator(cmd_args):
            abort(f"Arguments to command '{norm_cmd}' rejected: {cmd_args}", raw_args)

    log_command(True, raw_args)
    res = subprocess.run([REAL_ADB] + raw_args)
    sys.exit(res.returncode)

else:
    abort(f"Subcommand '{subcmd}' is not in the safe allowlist", raw_args)
