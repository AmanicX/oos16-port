#!/system/bin/sh
# ==============================================================================
# Stage-1 Safe Harness (Native Ramdisk PID root service)
# Enforces dynamic physical device write locks and active watchdog monitor.
# ==============================================================================

echo "==========================================================" > /dev/kmsg
echo "  STAGE-1 SAFE RAM HARNESS STARTING ON ONEPLUS 7T         " > /dev/kmsg
echo "==========================================================" > /dev/kmsg

# 1. Enforce read-only lock on all physical storage devices and partitions dynamically
rm -f /tmp/physical_storage_inventory /mnt/physical_storage_inventory /tmp/inventory.staging.$$ 2>/dev/null || true
STAGING_INV="/tmp/inventory.staging.$$"
: > "$STAGING_INV" || {
    echo "[STAGE1-FATAL] Unable to initialize staging inventory $STAGING_INV" > /dev/kmsg 2>/dev/null || true
    /system/bin/reboot bootloader 2>/dev/null || exit 1
}
PHYSICAL_DEV_COUNT=0

lock_node() {
    local sdir="$1"
    local dname="$2"
    if [ ! -f "$sdir/dev" ]; then
        echo "[STAGE1-FATAL] Missing sysfs dev in $sdir" > /dev/kmsg 2>/dev/null || true
        /system/bin/reboot bootloader 2>/dev/null || exit 1
    fi
    local mm
    mm=$(cat "$sdir/dev" 2>/dev/null | tr -d '[:space:]')
    case "$mm" in
        ''|*[!0-9:]*|*:*[:]*|*:|:*)
            echo "[STAGE1-FATAL] Malformed major:minor '$mm' in $sdir/dev" > /dev/kmsg 2>/dev/null || true
            /system/bin/reboot bootloader 2>/dev/null || exit 1
            ;;
    esac
    local maj="${mm%%:*}"
    local min="${mm##*:}"
    local dnode="/dev/block/$dname"
    /system/bin/toybox mkdir -p /dev/block 2>/dev/null || true
    if [ ! -b "$dnode" ]; then
        /system/bin/toybox mknod "$dnode" b "$maj" "$min" || {
            echo "[STAGE1-FATAL] mknod failed for $dnode" > /dev/kmsg 2>/dev/null || true
            /system/bin/reboot bootloader 2>/dev/null || exit 1
        }
    fi
    if [ ! -b "$dnode" ]; then
        echo "[STAGE1-FATAL] Node $dnode is not a block device" > /dev/kmsg 2>/dev/null || true
        /system/bin/reboot bootloader 2>/dev/null || exit 1
    fi
    /system/bin/toybox blockdev --setro "$dnode" || {
        echo "[STAGE1-FATAL] blockdev --setro failed on $dnode" > /dev/kmsg 2>/dev/null || true
        /system/bin/reboot bootloader 2>/dev/null || exit 1
    }
    local ro_val
    ro_val=$(/system/bin/toybox blockdev --getro "$dnode" 2>/dev/null || echo "0")
    if [ "$ro_val" != "1" ]; then
        echo "[STAGE1-FATAL] $dnode is not read-only (ro=$ro_val)" > /dev/kmsg 2>/dev/null || true
        /system/bin/reboot bootloader 2>/dev/null || exit 1
    fi
    echo "$dnode:$maj:$min:$sdir" >> "$STAGING_INV" || {
        echo "[STAGE1-FATAL] Failed to write inventory record for $dnode" > /dev/kmsg 2>/dev/null || true
        /system/bin/reboot bootloader 2>/dev/null || exit 1
    }
    PHYSICAL_DEV_COUNT=$((PHYSICAL_DEV_COUNT + 1))
    echo "[STAGE1] Physical node $dnode locked read-only (ro=$ro_val, $maj:$min)" > /dev/kmsg
}

for bdir in /sys/block/*; do
    [ -d "$bdir" ] || continue
    bname=$(basename "$bdir")
    case "$bname" in
        loop*|ram*|zram*|dm-*) continue ;;
    esac

    if [ -e "$bdir/device" ] || case "$bname" in sd*|mmcblk*) true ;; *) false ;; esac; then
        lock_node "$bdir" "$bname"

        # Discover and lock all child partitions
        for pdir in "$bdir"/"$bname"*; do
            [ -d "$pdir" ] || continue
            pname=$(basename "$pdir")
            lock_node "$pdir" "$pname"
        done
    fi
done

if [ "$PHYSICAL_DEV_COUNT" -eq 0 ]; then
    echo "[STAGE1-FATAL] No physical storage block devices discovered!" > /dev/kmsg 2>/dev/null || true
    /system/bin/reboot bootloader 2>/dev/null || exit 1
fi

# Post-Discovery Atomic Publication
DUP_DEVS=$(/system/bin/toybox cut -d: -f1 "$STAGING_INV" | /system/bin/toybox sort | /system/bin/toybox uniq -d || true)
if [ -n "$DUP_DEVS" ]; then
    echo "[STAGE1-FATAL] Duplicate device entries in staging inventory: $DUP_DEVS" > /dev/kmsg 2>/dev/null || true
    /system/bin/reboot bootloader 2>/dev/null || exit 1
fi

/system/bin/toybox cp "$STAGING_INV" "/mnt/physical_storage_inventory.tmp.$$" 2>/dev/null || true
/system/bin/toybox cp "$STAGING_INV" "/tmp/physical_storage_inventory.tmp.$$" 2>/dev/null || true
/system/bin/toybox mv -f "/mnt/physical_storage_inventory.tmp.$$" "/mnt/physical_storage_inventory" 2>/dev/null || true
/system/bin/toybox mv -f "/tmp/physical_storage_inventory.tmp.$$" "/tmp/physical_storage_inventory" 2>/dev/null || true
rm -f "$STAGING_INV" 2>/dev/null || true

if [ ! -s "/mnt/physical_storage_inventory" ] && [ ! -s "/tmp/physical_storage_inventory" ]; then
    echo "[STAGE1-FATAL] Failed to publish physical storage inventory!" > /dev/kmsg 2>/dev/null || true
    /system/bin/reboot bootloader 2>/dev/null || exit 1
fi

# 2. Continuous Safety Guard Loop in background
(
    echo "[STAGE1-GUARD] Continuous dynamic hardware RO monitor armed." > /dev/kmsg 2>/dev/null || true
    while true; do
        # Dynamically verify all physical devices and child partitions remain strictly read-only
        for bdir in /sys/block/*; do
            [ -d "$bdir" ] || continue
            bname=$(basename "$bdir")
            case "$bname" in loop*|ram*|zram*|dm-*) continue ;; esac
            if [ -e "$bdir/device" ] || case "$bname" in sd*|mmcblk*) true ;; *) false ;; esac; then
                dev_node="/dev/block/$bname"
                if [ -b "$dev_node" ]; then
                    ro_status=$(/system/bin/toybox blockdev --getro "$dev_node" 2>/dev/null)
                    if [ "$ro_status" != "1" ]; then
                        echo "[GUARD FATAL] Security violation: $dev_node became writable (ro=$ro_status)! Emergency rebooting!" > /dev/kmsg 2>/dev/null || true
                        /system/bin/toybox blockdev --setro "$dev_node" 2>/dev/null || true
                        /system/bin/reboot bootloader 2>/dev/null || true
                        exit 1
                    fi
                fi
                for pdir in "$bdir"/"$bname"*; do
                    [ -d "$pdir" ] || continue
                    pname=$(basename "$pdir")
                    part_node="/dev/block/$pname"
                    if [ -b "$part_node" ]; then
                        pro_status=$(/system/bin/toybox blockdev --getro "$part_node" 2>/dev/null)
                        if [ "$pro_status" != "1" ]; then
                            echo "[GUARD FATAL] Security violation: partition $part_node became writable (ro=$pro_status)! Emergency rebooting!" > /dev/kmsg 2>/dev/null || true
                            /system/bin/toybox blockdev --setro "$part_node" 2>/dev/null || true
                            /system/bin/reboot bootloader 2>/dev/null || true
                            exit 1
                        fi
                    fi
                done
            fi
        done
        /system/bin/toybox sleep 2
    done
) &

# 3. Launch Safety Watchdog Supervisor
if [ -x /system/bin/watchdog.sh ]; then
    /system/bin/sh /system/bin/watchdog.sh &
elif [ -f /scripts/watchdog.sh ]; then
    /system/bin/sh /scripts/watchdog.sh &
fi

# 3. Turn on screen backlight
if [ -f /sys/class/backlight/panel0-backlight/brightness ]; then
    echo 200 > /sys/class/backlight/panel0-backlight/brightness
fi

# 4. Trigger USB ADB mode
echo "[STAGE1] Setting sys.usb.config=adb..." > /dev/kmsg 2>/dev/null || true
/system/bin/toolbox setprop sys.usb.config adb

echo "==========================================================" > /dev/kmsg 2>/dev/null || true
echo "  STAGE-1 SAFE RAM HARNESS RUNNING & READY                " > /dev/kmsg 2>/dev/null || true
echo "  - Physical flash read-only verified                     " > /dev/kmsg 2>/dev/null || true
echo "  - ADB daemon ready                                      " > /dev/kmsg 2>/dev/null || true
echo "  - Watchdog active (heartbeat: $WATCHDOG_HEARTBEAT_FILE) " > /dev/kmsg 2>/dev/null || true
echo "==========================================================" > /dev/kmsg 2>/dev/null || true

# 5. Await Boot Trigger (/mnt/boot_now or /tmp/boot_now)
echo "[STAGE1-RECOVERY] Staging area ready. Waiting for runner image transfer and /mnt/boot_now trigger..." > /dev/kmsg 2>/dev/null || true
while [ ! -f /mnt/boot_now ] && [ ! -f /tmp/boot_now ]; do
    /system/bin/toybox sleep 1
done

echo "[STAGE1-RECOVERY] Trigger received (/mnt/boot_now)! Executing Stage-2 bringup..." > /dev/kmsg 2>/dev/null || true
/system/bin/toybox rm -f /mnt/boot_now /tmp/boot_now 2>/dev/null || true

if [ -x /system/bin/stage2_init.sh ]; then
    echo "[STAGE1-RECOVERY] Launching /system/bin/stage2_init.sh..." > /dev/kmsg 2>/dev/null || true
    exec /system/bin/sh /system/bin/stage2_init.sh
elif [ -f /scripts/stage2_init.sh ]; then
    echo "[STAGE1-RECOVERY] Launching /scripts/stage2_init.sh..." > /dev/kmsg 2>/dev/null || true
    exec /system/bin/sh /scripts/stage2_init.sh
else
    echo "[STAGE1-RECOVERY FATAL] Stage-2 initialization script missing from ramdisk!" > /dev/kmsg 2>/dev/null || true
    while true; do
        /system/bin/toybox sleep 60
    done
fi
